# ─────────────────────────────────────────────────────────────
# BioTrail — environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# RESEND — email capture backend.
# 1. Sign up at https://resend.com (free tier: 100 emails/day, 3000/month)
# 2. Verify your sending domain (or use the onboarding sandbox initially)
# 3. Create an API key under https://resend.com/api-keys
# 4. Paste it here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The address that receives a notification on every new signup.
# Use your team mailbox or a shared inbox (e.g. team@biotrail.com).
RESEND_NOTIFY_TO=hello@biotrail.com

# The "from" address Resend uses to send the confirmation.
# Must be on a domain you've verified inside Resend.
RESEND_FROM=BioTrail <hello@biotrail.com>

# PLAUSIBLE — privacy-friendly analytics + A/B test data.
# 1. Sign up at https://plausible.io (free 30-day trial, then ~9€/mo)
# 2. Add your domain (e.g. biotrail.com)
# 3. The script auto-loads in BaseLayout when this is set.
PUBLIC_PLAUSIBLE_DOMAIN=biotrail.com

# OPTIONAL — Self-host Plausible? Point this at your instance.
# Leave blank to use plausible.io
PUBLIC_PLAUSIBLE_HOST=
