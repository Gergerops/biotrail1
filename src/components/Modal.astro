---
/**
 * Modal — the Buffer-style smoke-test email capture.
 * Triggered by any element with [data-open-modal] and a [data-plan] attribute.
 * Submits to /api/capture which forwards to Resend and notifies the team.
 * Fires Plausible custom events for funnel tracking.
 */
import { getDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale | string;
}

const { locale } = Astro.props;
const dict = getDict(locale);
---

<div class="modal-backdrop" id="modal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <button class="modal-close" id="modalClose" aria-label="Close">×</button>

    <div id="modalDefault">
      <span class="eyebrow">{dict.modal.eyebrow}</span>
      <h3 id="modalTitle">{dict.modal.title}</h3>
      <p>{dict.modal.body}</p>
      <div class="modal-plan-pill" id="modalPill"></div>
      <form id="modalForm">
        <input
          type="email"
          required
          placeholder={dict.modal.placeholder}
          aria-label="Email address"
          name="email"
        />
        <button class="btn btn-primary" type="submit">{dict.modal.submit} →</button>
      </form>
      <p class="modal-error" id="modalError">{dict.modal.error}</p>
      <p class="modal-fine">{dict.modal.fine_print}</p>
    </div>

    <div id="modalSuccess" class="modal-success" style="display:none;">
      <div class="check">✓</div>
      <h3 style="font-size:26px;">{dict.modal.success_title}</h3>
      <p style="margin-top:14px;" id="modalSuccessBody">{dict.modal.success_body}</p>
      <button class="btn btn-ghost" id="modalSuccessClose" style="margin-top:24px;">
        {dict.modal.success_close}
      </button>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    locale,
    labels: {
      reserving_free: dict.modal.reserving_free,
      reserving_plus: dict.modal.reserving_plus,
      reserving_family: dict.modal.reserving_family,
      reserving_pro: dict.modal.reserving_pro,
    },
  }}
>
  (function () {
    const modal = document.getElementById('modal');
    const closeBtn = document.getElementById('modalClose');
    const form = document.getElementById('modalForm');
    const pill = document.getElementById('modalPill');
    const errorEl = document.getElementById('modalError');
    const defaultView = document.getElementById('modalDefault');
    const successView = document.getElementById('modalSuccess');
    const successCloseBtn = document.getElementById('modalSuccessClose');
    let currentPlan = 'general';

    function open(plan) {
      currentPlan = plan || 'general';

      // Reset views
      defaultView.style.display = '';
      successView.style.display = 'none';
      errorEl.classList.remove('show');
      form.querySelector('input').value = '';

      // Set plan pill
      const pillLabels = {
        free: labels.reserving_free,
        plus: labels.reserving_plus,
        family: labels.reserving_family,
        pro: labels.reserving_pro,
      };
      const pillLabel = pillLabels[currentPlan];
      if (pillLabel) {
        pill.innerHTML = pillLabel.replace(/(\S.+)/, '<strong>$1</strong>');
        pill.classList.add('show');
      } else {
        pill.classList.remove('show');
      }

      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      // Plausible event — opens count as funnel-top
      if (window.plausible) {
        window.plausible('modal_open', { props: { plan: currentPlan, locale } });
      }
    }

    function close() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    // Open triggers
    document.querySelectorAll('[data-open-modal]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open(el.getAttribute('data-plan') || 'general');
      });
    });

    // Close triggers
    closeBtn.addEventListener('click', close);
    successCloseBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) close();
    });

    // Submit handler — hits /api/capture
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.remove('show');
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = '...';

      const email = form.querySelector('input').value;

      try {
        const res = await fetch('/api/capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, plan: currentPlan, locale, source: 'modal' }),
        });

        if (!res.ok) throw new Error('capture failed');

        // Show success view
        defaultView.style.display = 'none';
        successView.style.display = '';

        // Google Ads conversion event — only fires after confirmed API success
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'conversion', {
            send_to: 'AW-18173922859/GoVFCPbR4a8cEKucgNpD',
            value: 5.0,
            currency: 'EUR',
            transaction_id: '',
          });
          window.gtag('event', 'signup', {
            plan: currentPlan,
            email_domain: email.split('@')[1],
          });
          console.log('[conversion] fired for plan:', currentPlan);
        }

        // Plausible — parallel signal
        if (typeof window.plausible === 'function') {
          window.plausible('Signup', { props: { plan: currentPlan } });
        }
      } catch (err) {
        errorEl.classList.add('show');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });

    // CTA-Final form (footer signup)
    const ctaForm = document.querySelector('[data-cta-form]');
    if (ctaForm) {
      ctaForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = ctaForm.querySelector('input').value;
        const submitBtn = ctaForm.querySelector('button');
        submitBtn.disabled = true;

        try {
          await fetch('/api/capture', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, plan: 'cta_final', locale, source: 'footer_cta' }),
          });
          ctaForm.innerHTML = '<p class="success-msg">✓ ' + email + '</p>';
          if (window.plausible) {
            window.plausible('signup', { props: { plan: 'cta_final', locale, source: 'footer_cta' } });
          }
        } catch (err) {
          submitBtn.disabled = false;
          alert('Something went wrong. Please try again.');
        }
      });
    }
  })();

  // Reveal-on-scroll for all .reveal elements
  (function () {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('is-visible');
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  })();
</script>
