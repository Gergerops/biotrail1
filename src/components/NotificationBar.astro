---
import { getDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale | string;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const items = [
  dict.notifications.notif_1,
  dict.notifications.notif_2,
  dict.notifications.notif_3,
];
---

<div class="notif-bar" role="status" aria-live="polite">
  <div class="notif-track">
    {items.map((text, i) => (
      <span class={`notif-item${i === 0 ? ' is-active' : ''}`}>{text}</span>
    ))}
  </div>
</div>

<style>
  .notif-bar {
    background: var(--c-ink);
    color: #fff;
    padding: 10px 16px;
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.005em;
    line-height: 1.4;
  }
  .notif-track {
    position: relative;
    display: block;
    min-height: 1.4em;
  }
  .notif-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
    color: rgba(255, 255, 255, 0.92);
  }
  .notif-item.is-active {
    opacity: 1;
    position: relative;
  }
</style>

<script is:inline>
  (function () {
    const items = document.querySelectorAll('.notif-bar .notif-item');
    if (items.length < 2) return;
    let i = 0;
    setInterval(() => {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, 4000);
  })();
</script>
