---
import { getDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale | string;
}

const { locale } = Astro.props;
const dict = getDict(locale);
---

<header class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <span class="eyebrow">{dict.hero.eyebrow}</span>
        <h1>
          {dict.hero.title_a}<br />
          <span class="accent">{dict.hero.title_b}</span> {dict.hero.title_c}
        </h1>
        <p class="hero-sub">{dict.hero.subtitle}</p>
        <div class="hero-cta">
          <button class="btn btn-primary btn-arrow" data-open-modal data-plan="hero">
            {dict.hero.cta_primary}
          </button>
          <a class="btn btn-ghost" href="#how">{dict.hero.cta_secondary}</a>
        </div>
        <div class="hero-trust">
          <span>{dict.hero.trust_1}</span>
          <span>{dict.hero.trust_2}</span>
          <span>{dict.hero.trust_3}</span>
        </div>
      </div>

      <div class="hero-visual reveal">
        <img
          src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1400&q=80"
          alt="A doctor in a white coat speaks warmly with a patient in a bright clinic"
          loading="eager"
          width="800"
          height="1000"
        />
        <div class="hero-badge">
          <div class="label">{dict.hero.badge_label}</div>
          <div class="quote">"{dict.hero.badge_quote}"</div>
        </div>
      </div>
    </div>
  </div>
</header>
