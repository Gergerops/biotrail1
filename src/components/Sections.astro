---
/**
 * All marketing sections of the landing page, in order:
 * Strip → Problem → Solution → Pricing → About → CtaFinal
 *
 * Kept in one file to make iteration on copy + flow easier.
 * Split into separate components later if any section gets reused elsewhere.
 */
import { getDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale | string;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const team = [
  { initial: 'G', name: 'Gero Schuler' },
  { initial: 'R', name: 'Raunak Malhotra' },
  { initial: 'E', name: 'Emelie Möller' },
  { initial: 'J', name: 'Julius Wieland' },
  { initial: 'M', name: 'Marcel Wissel' },
];
---

<!-- ─────── PROBLEM ─────── -->
<section class="block">
  <div class="container">
    <div class="block-head reveal">
      <span class="eyebrow">{dict.problem.eyebrow}</span>
      <h2>{dict.problem.title}</h2>
      <p>{dict.problem.subtitle}</p>
    </div>
    <div class="problems">
      <div class="problem-card reveal">
        <div class="num">01</div>
        <h3>{dict.problem.card_1_title}</h3>
        <p>{dict.problem.card_1_body}</p>
      </div>
      <div class="problem-card reveal">
        <div class="num">02</div>
        <h3>{dict.problem.card_2_title}</h3>
        <p>{dict.problem.card_2_body}</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────── SOLUTION ─────── -->
<section class="block solution" id="how">
  <div class="container">
    <div class="block-head reveal">
      <span class="eyebrow">{dict.solution.eyebrow}</span>
      <h2>{dict.solution.title}</h2>
      <p>{dict.solution.subtitle}</p>
    </div>

    <div class="steps">
      <!-- Step 1: Records translation -->
      <div class="step reveal">
        <div class="step-text">
          <div class="num">01</div>
          <h3>{dict.solution.step_1_title}</h3>
          <p>{dict.solution.step_1_body}</p>
        </div>
        <div class="step-visual" aria-hidden="true">
          <span class="mock-lang">EN ↔ TR</span>
          <div class="mock-row">
            <div class="dot blue"></div>
            <div class="lines"><div class="l1"></div><div class="l2"></div></div>
            <span class="badge">{dict.solution.mock_translated}</span>
          </div>
          <div class="mock-row">
            <div class="dot green"></div>
            <div class="lines"><div class="l1" style="width:50%"></div><div class="l2" style="width:75%"></div></div>
            <span class="badge">{dict.solution.mock_translated}</span>
          </div>
          <div class="mock-row">
            <div class="dot gold"></div>
            <div class="lines"><div class="l1" style="width:70%"></div><div class="l2" style="width:85%"></div></div>
            <span class="badge gold">{dict.solution.mock_reviewing}</span>
          </div>
        </div>
      </div>

      <!-- Step 2: Live translation -->
      <div class="step reverse reveal">
        <div class="step-text">
          <div class="num">02</div>
          <h3>{dict.solution.step_2_title}</h3>
          <p>{dict.solution.step_2_body}</p>
        </div>
        <div class="step-visual" aria-hidden="true">
          <div class="mock-translate">
            <div class="from">
              <small>{dict.solution.mock_you} (TR)</small>
              <strong>Karnım ağrıyor</strong>
            </div>
            <div class="arrow">→</div>
            <div class="to">
              <small>{dict.solution.mock_doctor} (DE)</small>
              <strong>Ich habe Bauchschmerzen</strong>
            </div>
          </div>
          <div class="mock-translate" style="background: linear-gradient(135deg, #FAFAF6 0%, #F3EFE7 100%);">
            <div class="from">
              <small>{dict.solution.mock_doctor} (DE)</small>
              <strong>Seit wann?</strong>
            </div>
            <div class="arrow">→</div>
            <div class="to">
              <small>{dict.solution.mock_you} (TR)</small>
              <strong>Ne zamandan beri?</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: System guide -->
      <div class="step reveal">
        <div class="step-text">
          <div class="num">03</div>
          <h3>{dict.solution.step_3_title}</h3>
          <p>{dict.solution.step_3_body}</p>
        </div>
        <div class="step-visual" aria-hidden="true">
          <span class="mock-lang">{dict.solution.glossary_lang}</span>
          <div class="mock-row">
            <div class="mock-text">
              <strong>{dict.solution.glossary_term_1}</strong>
              <small>{dict.solution.glossary_desc_1}</small>
            </div>
          </div>
          <div class="mock-row">
            <div class="mock-text">
              <strong>{dict.solution.glossary_term_2}</strong>
              <small>{dict.solution.glossary_desc_2}</small>
            </div>
          </div>
          <div class="mock-row">
            <div class="mock-text">
              <strong>{dict.solution.glossary_term_3}</strong>
              <small>{dict.solution.glossary_desc_3}</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4: Insurance link -->
      <div class="step reverse reveal">
        <div class="step-text">
          <div class="num">04</div>
          <h3>{dict.solution.step_4_title}</h3>
          <p>{dict.solution.step_4_body}</p>
        </div>
        <div class="step-visual" aria-hidden="true">
          <span class="mock-lang">{dict.solution.insurance_lang}</span>
          <div class="mock-row">
            <div class="mock-text"><strong>{dict.solution.insurance_row_1}</strong></div>
            <span class="badge">{dict.solution.insurance_badge_1}</span>
          </div>
          <div class="mock-row">
            <div class="mock-text"><strong>{dict.solution.insurance_row_2}</strong></div>
            <span class="badge gold">{dict.solution.insurance_badge_2}</span>
          </div>
          <div class="mock-row">
            <div class="mock-text"><strong>{dict.solution.insurance_row_3}</strong></div>
            <span class="badge red">{dict.solution.insurance_badge_3}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ─────── PRICING (smoke test) ─────── -->
<section class="block" id="pricing">
  <div class="container">
    <div class="block-head reveal" style="margin-left:auto; margin-right:auto; text-align:center; max-width: 640px;">
      <span class="eyebrow" style="justify-content:center;">{dict.pricing.eyebrow}</span>
      <h2>{dict.pricing.title}</h2>
      <p style="margin-left:auto; margin-right:auto;">{dict.pricing.subtitle}</p>
    </div>

    <div class="pricing-grid">
      <!-- Free plan -->
      <div class="plan reveal" data-plan="free">
        <div class="plan-name">{dict.pricing.free_name}</div>
        <div class="plan-price">
          <span class="num">{dict.pricing.free_price}</span>
          <span class="per">{dict.pricing.free_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.free_desc}</p>
        <ul>
          <li>{dict.pricing.free_feat_1}</li>
          <li>{dict.pricing.free_feat_2}</li>
          <li>{dict.pricing.free_feat_3}</li>
          <li>{dict.pricing.free_feat_4}</li>
        </ul>
        <button class="btn btn-ghost" data-open-modal data-plan="free">{dict.pricing.free_cta}</button>
      </div>

      <!-- Plus plan (popular) -->
      <div class="plan plan-pop reveal" data-plan="plus">
        <span class="ribbon">{dict.pricing.plus_ribbon}</span>
        <div class="plan-name">{dict.pricing.plus_name}</div>
        <div class="plan-price">
          <span class="num">{dict.pricing.plus_price}</span>
          <span class="per">{dict.pricing.plus_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.plus_desc}</p>
        <ul>
          <li>{dict.pricing.plus_feat_1}</li>
          <li>{dict.pricing.plus_feat_2}</li>
          <li>{dict.pricing.plus_feat_3}</li>
          <li>{dict.pricing.plus_feat_4}</li>
          <li>{dict.pricing.plus_feat_5}</li>
        </ul>
        <button class="btn btn-primary" data-open-modal data-plan="plus">{dict.pricing.plus_cta}</button>
      </div>

      <!-- Family plan -->
      <div class="plan reveal" data-plan="family">
        <div class="plan-name">{dict.pricing.family_name}</div>
        <div class="plan-price">
          <span class="num">{dict.pricing.family_price}</span>
          <span class="per">{dict.pricing.family_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.family_desc}</p>
        <ul>
          <li>{dict.pricing.family_feat_1}</li>
          <li>{dict.pricing.family_feat_2}</li>
          <li>{dict.pricing.family_feat_3}</li>
          <li>{dict.pricing.family_feat_4}</li>
          <li>{dict.pricing.family_feat_5}</li>
        </ul>
        <button class="btn btn-ghost" data-open-modal data-plan="family">{dict.pricing.family_cta}</button>
      </div>

      <!-- Pro plan -->
      <div class="plan reveal" data-plan="pro">
        <div class="plan-name">{dict.pricing.pro_name}</div>
        <div class="plan-price">
          <span class="num">{dict.pricing.pro_price}</span>
          <span class="per">{dict.pricing.pro_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.pro_desc}</p>
        <ul>
          <li>{dict.pricing.pro_feat_1}</li>
          <li>{dict.pricing.pro_feat_2}</li>
          <li>{dict.pricing.pro_feat_3}</li>
          <li>{dict.pricing.pro_feat_4}</li>
          <li>{dict.pricing.pro_feat_5}</li>
        </ul>
        <button class="btn btn-ghost" data-open-modal data-plan="pro">{dict.pricing.pro_cta}</button>
      </div>
    </div>
    <p class="pricing-note">{dict.pricing.footnote}</p>
  </div>
</section>

<!-- ─────── ABOUT ─────── -->
<section class="block about">
  <div class="container">
    <div class="about-grid">
      <div class="reveal">
        <span class="eyebrow">{dict.about.eyebrow}</span>
        <h2>{dict.about.title}</h2>
        <p>{dict.about.body}</p>
      </div>
      <div class="team reveal">
        {team.map((p) => (
          <div class="team-row">
            <div class="initial">{p.initial}</div>
            <div class="name">{p.name}</div>
            <div class="role">{dict.about.role_co_founder}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ─────── CTA FINAL ─────── -->
<section class="cta-final">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow" style="justify-content:center;">{dict.cta_final.eyebrow}</span>
      <h2 style="margin-top: 18px;">{dict.cta_final.title}</h2>
      <p>{dict.cta_final.subtitle}</p>
      <form id="ctaForm" data-cta-form>
        <input
          type="email"
          required
          placeholder={dict.cta_final.placeholder}
          aria-label="Email address"
          name="email"
        />
        <button class="btn btn-primary btn-arrow" type="submit">{dict.cta_final.submit}</button>
      </form>
    </div>
  </div>
</section>
