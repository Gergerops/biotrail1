---
/**
 * All marketing sections of the landing page, in order:
 * Strip → Problem → Solution → Pricing → About → CtaFinal
 *
 * Kept in one file to make iteration on copy + flow easier.
 * Split into separate components later if any section gets reused elsewhere.
 */
import { getDict, type Locale } from '~/i18n';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  locale: Locale | string;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const team = [
  { initial: 'G', name: 'Gero Schuler' },
  { initial: 'R', name: 'Raunak Malhotra' },
  { initial: 'E', name: 'Emelie Möller' },
  { initial: 'J', name: 'Julius Wieland' },
  { initial: 'M', name: 'Marcel Wissel' },
];
---

<!-- ─────── PROBLEM ─────── -->
<section class="block">
  <div class="container">
    <div class="block-head reveal">
      <span class="eyebrow">{dict.problem.eyebrow}</span>
      <h2>{dict.problem.title}</h2>
      <p>{dict.problem.subtitle}</p>
    </div>
    <div class="problems">
      <div class="problem-card reveal">
        <div class="num">01</div>
        <h3>{dict.problem.card_1_title}</h3>
        <p>{dict.problem.card_1_body}</p>
      </div>
      <div class="problem-card reveal">
        <div class="num">02</div>
        <h3>{dict.problem.card_2_title}</h3>
        <p>{dict.problem.card_2_body}</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────── COMPARISON ─────── -->
<section class="block">
  <div class="container">
    <div class="block-head reveal" style="margin-left:auto; margin-right:auto; text-align:center; max-width: 720px;">
      <span class="eyebrow" style="justify-content:center;">{dict.comparison.eyebrow}</span>
      <h2>{dict.comparison.title}</h2>
      <p style="margin-left:auto; margin-right:auto;">{dict.comparison.subtitle}</p>
    </div>

    <div class="compare-wrap reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th>{dict.comparison.col_feature}</th>
            <th class="col-biotrail">{dict.comparison.col_biotrail}</th>
            <th>{dict.comparison.col_translators}</th>
            <th>{dict.comparison.col_medical}</th>
            <th>{dict.comparison.col_records}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{dict.comparison.row_1}</th>
            <td class="col-biotrail"><span class="yes">✓</span></td>
            <td><span class="no">—</span></td>
            <td><span class="yes">✓</span></td>
            <td><span class="no">—</span></td>
          </tr>
          <tr>
            <th scope="row">{dict.comparison.row_2}</th>
            <td class="col-biotrail"><span class="yes">✓</span></td>
            <td><span class="no">—</span></td>
            <td><span class="no">—</span></td>
            <td><span class="yes">✓</span></td>
          </tr>
          <tr>
            <th scope="row">{dict.comparison.row_3}</th>
            <td class="col-biotrail"><span class="yes">✓</span></td>
            <td><span class="no">—</span></td>
            <td><span class="no">—</span></td>
            <td><span class="no">—</span></td>
          </tr>
          <tr>
            <th scope="row">{dict.comparison.row_4}</th>
            <td class="col-biotrail"><span class="yes">✓</span></td>
            <td><span class="no">—</span></td>
            <td><span class="no">—</span></td>
            <td><span class="no">—</span></td>
          </tr>
          <tr>
            <th scope="row">{dict.comparison.row_5}</th>
            <td class="col-biotrail"><span class="yes">✓</span></td>
            <td><span class="yes">✓</span></td>
            <td><span class="no">—</span></td>
            <td><span class="no">—</span></td>
          </tr>
        </tbody>
      </table>

      <div class="compare-stack">
        {[
          { feat: dict.comparison.row_1, vals: [true, false, true, false] },
          { feat: dict.comparison.row_2, vals: [true, false, false, true] },
          { feat: dict.comparison.row_3, vals: [true, false, false, false] },
          { feat: dict.comparison.row_4, vals: [true, false, false, false] },
          { feat: dict.comparison.row_5, vals: [true, true, false, false] },
        ].map((row) => (
          <div class="stack-card">
            <div class="stack-feat">{row.feat}</div>
            <ul>
              <li class="is-biotrail"><span class={`mark ${row.vals[0] ? 'yes' : 'no'}`}>{row.vals[0] ? '✓' : '—'}</span> {dict.comparison.col_biotrail}</li>
              <li><span class={`mark ${row.vals[1] ? 'yes' : 'no'}`}>{row.vals[1] ? '✓' : '—'}</span> {dict.comparison.col_translators}</li>
              <li><span class={`mark ${row.vals[2] ? 'yes' : 'no'}`}>{row.vals[2] ? '✓' : '—'}</span> {dict.comparison.col_medical}</li>
              <li><span class={`mark ${row.vals[3] ? 'yes' : 'no'}`}>{row.vals[3] ? '✓' : '—'}</span> {dict.comparison.col_records}</li>
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ─────── SEGMENTS ─────── -->
<section class="block">
  <div class="container">
    <div class="block-head reveal" style="margin-left:auto; margin-right:auto; text-align:center; max-width: 720px;">
      <span class="eyebrow" style="justify-content:center;">{dict.segments.eyebrow}</span>
      <h2>{dict.segments.title}</h2>
      <p style="margin-left:auto; margin-right:auto;">{dict.segments.subtitle}</p>
    </div>

    <div class="segments-grid">
      <div class="segment-card reveal">
        <span class="segment-label">{dict.segments.seg_1_label}</span>
        <h3>{dict.segments.seg_1_title}</h3>
        <p>{dict.segments.seg_1_body}</p>
      </div>
      <div class="segment-card reveal">
        <span class="segment-label">{dict.segments.seg_2_label}</span>
        <h3>{dict.segments.seg_2_title}</h3>
        <p>{dict.segments.seg_2_body}</p>
      </div>
      <div class="segment-card reveal">
        <span class="segment-label">{dict.segments.seg_3_label}</span>
        <h3>{dict.segments.seg_3_title}</h3>
        <p>{dict.segments.seg_3_body}</p>
      </div>
    </div>
  </div>
</section>

<!-- ─────── SOLUTION ─────── -->
<section class="block solution" id="how">
  <div class="container">
    <div class="block-head reveal">
      <span class="eyebrow">{dict.solution.eyebrow}</span>
      <h2>{dict.solution.title}</h2>
      <p>{dict.solution.subtitle}</p>
    </div>

    <div class="steps">
      <!-- Step 1: Records translation -->
      <div class="step reveal">
        <div class="step-text">
          <div class="num">01</div>
          <h3>{dict.solution.step_1_title}</h3>
          <p>{dict.solution.step_1_body}</p>
        </div>
        <div class="step-visual">
          <PhoneFrame appName="My documents">
            <div class="doc-card">
              <div class="doc-icon doc-icon-rx">℞</div>
              <div class="doc-meta">
                <div class="doc-title">Prescription</div>
                <div class="doc-sub">Dr. Müller · 14 May</div>
              </div>
              <span class="doc-badge translated">Translated</span>
            </div>
            <div class="doc-card">
              <div class="doc-icon doc-icon-vacc">✚</div>
              <div class="doc-meta">
                <div class="doc-title">Vaccination card</div>
                <div class="doc-sub">6 entries</div>
              </div>
              <span class="doc-badge translated">Translated</span>
            </div>
            <div class="doc-card">
              <div class="doc-icon doc-icon-lab">⏲</div>
              <div class="doc-meta">
                <div class="doc-title">Blood test</div>
                <div class="doc-sub">3 Apr · Uniklinik</div>
              </div>
              <span class="doc-badge reviewing">Reviewing</span>
            </div>
            <button class="doc-add" type="button" tabindex="-1">＋ Add document</button>
          </PhoneFrame>
        </div>
      </div>

      <!-- Step 2: Live translation -->
      <div class="step reverse reveal">
        <div class="step-text">
          <div class="num">02</div>
          <h3>{dict.solution.step_2_title}</h3>
          <p>{dict.solution.step_2_body}</p>
        </div>
        <div class="step-visual">
          <PhoneFrame appName="Live translation">
            <div class="live-active">
              <div class="live-dot"></div>
              <span>Listening · TR → DE</span>
            </div>
            <div class="live-bubble live-bubble-you">
              <div class="live-bubble-label">You · Turkish</div>
              <div class="live-bubble-text">Karnım ağrıyor</div>
            </div>
            <div class="live-bubble live-bubble-doctor">
              <div class="live-bubble-label">Doctor hears · Deutsch</div>
              <div class="live-bubble-text">Ich habe Bauchschmerzen</div>
            </div>
            <div class="live-bubble live-bubble-doctor live-bubble-doctor-back">
              <div class="live-bubble-label">Doctor · Deutsch</div>
              <div class="live-bubble-text">Seit wann?</div>
            </div>
            <div class="live-bubble live-bubble-you live-bubble-you-back">
              <div class="live-bubble-label">You hear · Turkish</div>
              <div class="live-bubble-text">Ne zamandan beri?</div>
            </div>
            <div class="live-mic">
              <span class="mic-dot"></span>
              <span class="mic-dot"></span>
              <span class="mic-dot"></span>
            </div>
          </PhoneFrame>
        </div>
      </div>

      <!-- Step 3: System guide -->
      <div class="step reveal">
        <div class="step-text">
          <div class="num">03</div>
          <h3>{dict.solution.step_3_title}</h3>
          <p>{dict.solution.step_3_body}</p>
        </div>
        <div class="step-visual">
          <PhoneFrame appName="German healthcare 101">
            <div class="glossary-search">🔍 Search a term…</div>
            <div class="glossary-card">
              <div class="glossary-term">Hausarzt</div>
              <div class="glossary-def">Your family doctor. The first stop for non-emergency issues. They refer you to specialists.</div>
              <span class="glossary-when">When you need them: first.</span>
            </div>
            <div class="glossary-card">
              <div class="glossary-term">Überweisung</div>
              <div class="glossary-def">A referral note. You need one from your Hausarzt to see most specialists.</div>
              <span class="glossary-when">When: before booking a Facharzt.</span>
            </div>
            <div class="glossary-card glossary-card-emergency">
              <div class="glossary-term">Notaufnahme</div>
              <div class="glossary-def">Emergency room. Only for life-threatening situations.</div>
              <span class="glossary-when">When: real emergency only.</span>
            </div>
          </PhoneFrame>
        </div>
      </div>

      <!-- Step 4: Insurance link -->
      <div class="step reverse reveal">
        <div class="step-text">
          <div class="num">04</div>
          <h3>{dict.solution.step_4_title}</h3>
          <p>{dict.solution.step_4_body}</p>
        </div>
        <div class="step-visual">
          <PhoneFrame appName="My Krankenkasse">
            <div class="insurance-card">
              <div class="insurance-label">Insured with</div>
              <div class="insurance-name">TK · Techniker Krankenkasse</div>
              <div class="insurance-id">Member · A1234567890</div>
            </div>
            <div class="insurance-row">
              <div class="insurance-svc">
                <div class="insurance-svc-title">Annual check-up</div>
                <div class="insurance-svc-sub">Hausarzt visit</div>
              </div>
              <span class="insurance-cost insurance-covered">Covered</span>
            </div>
            <div class="insurance-row">
              <div class="insurance-svc">
                <div class="insurance-svc-title">Prescribed antibiotic</div>
                <div class="insurance-svc-sub">Amoxicillin 500mg</div>
              </div>
              <span class="insurance-cost insurance-partial">€5 Zuzahlung</span>
            </div>
            <div class="insurance-row">
              <div class="insurance-svc">
                <div class="insurance-svc-title">Dental cleaning</div>
                <div class="insurance-svc-sub">Professional</div>
              </div>
              <span class="insurance-cost insurance-not">Not covered</span>
            </div>
          </PhoneFrame>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ─────── EMERGENCY (always-on free feature) ─────── -->
<section class="emergency">
  <div class="container">
    <div class="emergency-grid">
      <div class="emergency-copy reveal">
        <span class="eyebrow">{dict.emergency.eyebrow}</span>
        <h2>{dict.emergency.title}</h2>
        <p>{dict.emergency.body}</p>
        <ul class="emergency-feats">
          <li>{dict.emergency.feat_1}</li>
          <li>{dict.emergency.feat_2}</li>
          <li>{dict.emergency.feat_3}</li>
        </ul>
      </div>
      <div class="emergency-visual reveal" aria-hidden="true">
        <div class="lockscreen-mockup" aria-hidden="true">
          <div class="lockscreen-island"></div>
          <div class="lockscreen-statusbar">
            <span class="time-small">9:41</span>
            <span class="indicators">
              <svg width="17" height="11" viewBox="0 0 17 11" fill="white" aria-hidden="true">
                <rect x="0" y="7" width="3" height="4" rx="0.5"/>
                <rect x="4" y="5" width="3" height="6" rx="0.5"/>
                <rect x="8" y="3" width="3" height="8" rx="0.5"/>
                <rect x="12" y="0" width="3" height="11" rx="0.5"/>
              </svg>
              <svg width="16" height="11" viewBox="0 0 16 11" fill="none" stroke="white" stroke-width="1.5" aria-hidden="true">
                <path d="M1.5 4.5C3.5 2.5 6 1.5 8 1.5C10 1.5 12.5 2.5 14.5 4.5M3.5 6.5C5 5 6.5 4.5 8 4.5C9.5 4.5 11 5 12.5 6.5M5.5 8.5C6.5 7.5 7.5 7 8 7C8.5 7 9.5 7.5 10.5 8.5"/>
                <circle cx="8" cy="10" r="1" fill="white"/>
              </svg>
              <svg width="24" height="11" viewBox="0 0 24 11" fill="none" aria-hidden="true">
                <rect x="0.5" y="0.5" width="20" height="10" rx="2" stroke="white" stroke-opacity="0.5"/>
                <rect x="2" y="2" width="17" height="7" rx="1" fill="white"/>
                <rect x="21" y="3.5" width="1.5" height="4" rx="0.5" fill="white" fill-opacity="0.5"/>
              </svg>
            </span>
          </div>
          <div class="lockscreen-clock">
            <div class="weekday">Tuesday, 14 May</div>
            <div class="bigclock">9:41</div>
          </div>
          <div class="lockscreen-notification">
            <div class="notif-accent-bar"></div>
            <div class="notif-content">
              <div class="notif-header">
                <span class="brand-square">B</span>
                <span class="notif-app">BioTrail · Emergency</span>
                <span class="notif-time">now</span>
              </div>
              <div class="notif-title">Medical info available</div>
              <div class="notif-body">
                <div class="notif-row"><span class="label">Name</span><span class="val">Maria K.</span></div>
                <div class="notif-row"><span class="label">Blood type</span><span class="val">O+</span></div>
                <div class="notif-row"><span class="label">Allergies</span><span class="val">Penicillin, latex</span></div>
                <div class="notif-row"><span class="label">Medication</span><span class="val">Metoprolol 50mg</span></div>
              </div>
              <div class="notif-foot">Tap to view full card</div>
            </div>
          </div>
          <div class="lockscreen-hint">Swipe up for full card · Offline</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─────── PRICING (smoke test) ─────── -->
<section class="block" id="pricing">
  <div class="container">
    <div class="block-head reveal" style="margin-left:auto; margin-right:auto; text-align:center; max-width: 640px;">
      <span class="eyebrow" style="justify-content:center;">{dict.pricing.eyebrow}</span>
      <h2>{dict.pricing.title}</h2>
      <p style="margin-left:auto; margin-right:auto;">{dict.pricing.subtitle}</p>
      <p class="pricing-subtitle-note">{dict.pricing.subtitle_note}</p>
    </div>

    <div class="pricing-toggle-wrap reveal">
      <div class="pricing-toggle" role="tablist" aria-label="Billing period">
        <button type="button" class="is-active" data-period="monthly" role="tab" aria-selected="true">{dict.pricing.toggle_monthly}</button>
        <button type="button" data-period="yearly" role="tab" aria-selected="false">{dict.pricing.toggle_yearly}</button>
      </div>
    </div>

    <div class="pricing-grid">
      <!-- Free plan -->
      <div class="plan reveal" data-plan="free">
        <div class="plan-name">{dict.pricing.free_name}</div>
        <div class="plan-price">
          <span class="num">{dict.pricing.free_price}</span>
          <span class="per">{dict.pricing.free_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.free_desc}</p>
        <ul>
          <li>{dict.pricing.free_feat_1}</li>
          <li>{dict.pricing.free_feat_2}</li>
          <li>{dict.pricing.free_feat_3}</li>
          <li>{dict.pricing.free_feat_4}</li>
        </ul>
        <button class="btn btn-ghost" data-open-modal data-plan="free">{dict.pricing.free_cta}</button>
      </div>

      <!-- Plus plan (popular) -->
      <div class="plan plan-pop reveal" data-plan="plus">
        <span class="ribbon">{dict.pricing.plus_ribbon}</span>
        <div class="plan-name">{dict.pricing.plus_name}</div>
        <div class="plan-price">
          <span class="num" data-monthly={dict.pricing.plus_price} data-yearly={dict.pricing.plus_price_yearly}>{dict.pricing.plus_price}</span>
          <span class="per" data-monthly={dict.pricing.plus_period} data-yearly={dict.pricing.plus_period_yearly}>{dict.pricing.plus_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.plus_desc}</p>
        <ul>
          <li>{dict.pricing.plus_feat_1}</li>
          <li>{dict.pricing.plus_feat_2}</li>
          <li>{dict.pricing.plus_feat_3}</li>
          <li>{dict.pricing.plus_feat_4}</li>
          <li>{dict.pricing.plus_feat_5}</li>
        </ul>
        <button class="btn btn-primary" data-open-modal data-plan="plus">{dict.pricing.plus_cta}</button>
        <p class="plan-trial-note">{dict.pricing.plus_trial_note}</p>
      </div>

      <!-- Family plan -->
      <div class="plan reveal" data-plan="family">
        <div class="plan-name">{dict.pricing.family_name}</div>
        <div class="plan-price">
          <span class="num" data-monthly={dict.pricing.family_price} data-yearly={dict.pricing.family_price_yearly}>{dict.pricing.family_price}</span>
          <span class="per" data-monthly={dict.pricing.family_period} data-yearly={dict.pricing.family_period_yearly}>{dict.pricing.family_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.family_desc}</p>
        <ul>
          <li>{dict.pricing.family_feat_1}</li>
          <li>{dict.pricing.family_feat_2}</li>
          <li>{dict.pricing.family_feat_3}</li>
          <li>{dict.pricing.family_feat_4}</li>
          <li>{dict.pricing.family_feat_5}</li>
        </ul>
        <button class="btn btn-ghost" data-open-modal data-plan="family">{dict.pricing.family_cta}</button>
      </div>

      <!-- Pro plan -->
      <div class="plan reveal" data-plan="pro">
        <div class="plan-name">{dict.pricing.pro_name}</div>
        <div class="plan-price">
          <span class="num" data-monthly={dict.pricing.pro_price} data-yearly={dict.pricing.pro_price_yearly}>{dict.pricing.pro_price}</span>
          <span class="per" data-monthly={dict.pricing.pro_period} data-yearly={dict.pricing.pro_period_yearly}>{dict.pricing.pro_period}</span>
        </div>
        <p class="plan-desc">{dict.pricing.pro_desc}</p>
        <ul>
          <li>{dict.pricing.pro_feat_1}</li>
          <li>{dict.pricing.pro_feat_2}</li>
          <li>{dict.pricing.pro_feat_3}</li>
          <li>{dict.pricing.pro_feat_4}</li>
          <li>{dict.pricing.pro_feat_5}</li>
        </ul>
        <button class="btn btn-ghost" data-open-modal data-plan="pro">{dict.pricing.pro_cta}</button>
      </div>
    </div>
    <p class="pricing-note">{dict.pricing.footnote}</p>
  </div>
</section>

<!-- ─────── ABOUT ─────── -->
<section class="block about">
  <div class="container">
    <div class="about-grid">
      <div class="reveal">
        <span class="eyebrow">{dict.about.eyebrow}</span>
        <h2>{dict.about.title}</h2>
        <p>{dict.about.body}</p>
      </div>
      <div class="team reveal">
        {team.map((p) => (
          <div class="team-row">
            <div class="initial">{p.initial}</div>
            <div class="name">{p.name}</div>
            <div class="role">{dict.about.role_co_founder}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ─────── CTA FINAL ─────── -->
<section class="cta-final">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow" style="justify-content:center;">{dict.cta_final.eyebrow}</span>
      <h2 style="margin-top: 18px;">{dict.cta_final.title}</h2>
      <p>{dict.cta_final.subtitle}</p>
      <form id="ctaForm" data-cta-form>
        <input
          type="email"
          required
          placeholder={dict.cta_final.placeholder}
          aria-label="Email address"
          name="email"
        />
        <button class="btn btn-primary btn-arrow" type="submit">{dict.cta_final.submit}</button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const toggle = document.querySelector('.pricing-toggle');
    if (!toggle) return;
    const grid = document.querySelector('.pricing-grid');
    const buttons = toggle.querySelectorAll('button[data-period]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const period = btn.getAttribute('data-period');
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        if (grid) grid.classList.toggle('is-yearly', period === 'yearly');
        document.querySelectorAll('[data-monthly][data-yearly]').forEach((el) => {
          const val = el.getAttribute(period === 'yearly' ? 'data-yearly' : 'data-monthly');
          if (val !== null) el.textContent = val;
        });
        if (window.plausible) {
          window.plausible('pricing_toggle', { props: { period } });
        }
      });
    });
  })();
</script>
