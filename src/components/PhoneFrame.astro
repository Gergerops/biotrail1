---
/**
 * PhoneFrame — iPhone-15-Pro-style mockup with iOS 17 chrome
 * (Dynamic Island, large-title navbar, optional search bar,
 * bottom tab bar, home indicator).
 *
 * Used by the Solution-section step visuals so every screen feels
 * like one connected product.
 */
interface Props {
  time?: string;
  navTitle: string;
  activeTab: 'documents' | 'translate' | 'glossary' | 'insurance';
  showSearch?: boolean;
  showNavButton?: boolean;
  navButtonIcon?: string;
}
const {
  time = '9:41',
  navTitle,
  activeTab,
  showSearch = false,
  showNavButton = false,
  navButtonIcon = '+',
} = Astro.props;

const tabs = [
  { id: 'documents', label: 'Documents', icon: 'M3 6h18M3 12h18M3 18h18' },
  { id: 'translate', label: 'Translate', icon: 'M3 5h12M9 3v2M5 13l-2 4h4l-2-4zM15 7l3 8h-6l3-8z' },
  { id: 'glossary',  label: 'Glossary',  icon: 'M4 4h12a2 2 0 012 2v14H6a2 2 0 01-2-2V4zM4 4l2 2M16 4l2 2v14' },
  { id: 'insurance', label: 'Insurance', icon: 'M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z' },
];
---

<div class="phone-frame" aria-hidden="true">
  <div class="phone-island"></div>
  <div class="phone-statusbar">
    <span class="time-small">{time}</span>
    <span class="indicators">
      <svg width="17" height="11" viewBox="0 0 17 11" fill="currentColor" aria-hidden="true">
        <rect x="0" y="7" width="3" height="4" rx="0.5"/>
        <rect x="4" y="5" width="3" height="6" rx="0.5"/>
        <rect x="8" y="3" width="3" height="8" rx="0.5"/>
        <rect x="12" y="0" width="3" height="11" rx="0.5"/>
      </svg>
      <svg width="16" height="11" viewBox="0 0 16 11" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M1.5 4.5C3.5 2.5 6 1.5 8 1.5C10 1.5 12.5 2.5 14.5 4.5M3.5 6.5C5 5 6.5 4.5 8 4.5C9.5 4.5 11 5 12.5 6.5M5.5 8.5C6.5 7.5 7.5 7 8 7C8.5 7 9.5 7.5 10.5 8.5"/>
        <circle cx="8" cy="10" r="1" fill="currentColor"/>
      </svg>
      <svg width="24" height="11" viewBox="0 0 24 11" fill="none" aria-hidden="true">
        <rect x="0.5" y="0.5" width="20" height="10" rx="2" stroke="currentColor" stroke-opacity="0.5"/>
        <rect x="2" y="2" width="17" height="7" rx="1" fill="currentColor"/>
        <rect x="21" y="3.5" width="1.5" height="4" rx="0.5" fill="currentColor" fill-opacity="0.5"/>
      </svg>
    </span>
  </div>

  <div class="phone-navbar">
    <span class="phone-navtitle">{navTitle}</span>
    {showNavButton && (
      <button class="phone-navbutton" type="button" tabindex="-1" aria-hidden="true">{navButtonIcon}</button>
    )}
  </div>

  {showSearch && (
    <div class="phone-searchbar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <span>Search</span>
    </div>
  )}

  <div class="phone-screen">
    <div class="phone-app-body">
      <slot />
    </div>
  </div>

  <div class="phone-tabbar">
    {tabs.map((tab) => (
      <div class={`phone-tab ${activeTab === tab.id ? 'active' : ''}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={tab.icon}/>
        </svg>
        <span>{tab.label}</span>
      </div>
    ))}
  </div>

  <div class="phone-home-indicator"></div>
</div>
